# Unity Project - .gitignore
# Kaynak: https://github.com/github/gitignore/blob/main/Unity.gitignore

# === Unity'nin oluşturduğu geçici/veritabanı klasörleri ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
ExportedObj/
.consulo/
sysinfo.txt

# === Visual Studio ve Rider için ===
.vs/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.log

# === Unity Meta dosyaları (debug) ===
*.pidb.meta
*.pdb.meta
*.mdb.meta

# === Çıktı dosyaları ve derlenmiş buildler ===
*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta

# === Büyük veri klasörleri (RAM dump / kayıtlar) ===
[Mm]emoryCaptures/
[Rr]ecordings/

# === JetBrains Rider otomatik eklentisi ===
Assets/Plugins/Editor/JetBrains*

# === AssetStore Tools (isteğe bağlı dışlanabilir) ===
# Assets/AssetStoreTools*

# === Addressables ===
Assets/AddressableAssetsData/*/*.bin*

# === Android StreamingAssets Geçici Dosyaları ===
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*

# === Özel Unity Araçları (örn. RoadArchitect) ===
RoadArchitect/TerrainHistory/

# === Genel sistem dosyaları (Windows/macOS) ===
.DS_Store
Thumbs.db

# === Unity Oturum verisi ===
.utmp/